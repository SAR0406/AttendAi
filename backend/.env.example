# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# Recall.ai (optional if you only import recordings)
RECALL_API_KEY=your-recall-api-key
RECALL_WEBHOOK_SECRET=your-recall-webhook-secret

# Deepgram (used when TRANSCRIPTION_PROVIDER=deepgram, the default)
DEEPGRAM_API_KEY=your-deepgram-api-key

# ─── NVIDIA Riva ASR ────────────────────────────────────────────────────────
# Set TRANSCRIPTION_PROVIDER=riva to use NVIDIA Riva whisper-large-v3
# instead of Deepgram for post-meeting transcript processing.
TRANSCRIPTION_PROVIDER=deepgram
NVIDIA_API_KEY=your-nvidia-api-key
# BCP-47 language code. Use "multi" for automatic language detection.
# See https://docs.nvidia.com/deeplearning/riva/user-guide/docs/asr/asr-overview.html
RIVA_LANGUAGE_CODE=en
# "transcribe" (default) or "translate" to translate audio to English
RIVA_TASK=transcribe

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Choose "nim" for NVIDIA NIM (glm-5 / minimax-2.5) or "claude" for Anthropic.
LLM_PROVIDER=nim
LLM_MODEL=glm-5
NIM_API_BASE_URL=https://integrate.api.nvidia.com/v1
# If omitted, NVIDIA_API_KEY is reused for NIM.
NIM_API_KEY=your-nvidia-api-key
# Enable if your NIM endpoint supports web search tools.
NIM_ENABLE_WEB_SEARCH=false

# Anthropic (Claude) – only required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Storage Provider ────────────────────────────────────────────────────────
# Choose one: r2 | s3 | backblaze | minio | supabase | local
# Default is "r2" (Cloudflare R2) for backward compatibility.
STORAGE_PROVIDER=r2

# ── Option 1: Cloudflare R2 (original default, requires billing card) ──────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=attendai-files
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Option 2: AWS S3 (5 GB free tier, requires billing card) ───────────────
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=attendai-files
# AWS_S3_PUBLIC_URL=https://attendai-files.s3.amazonaws.com   # leave empty to use pre-signed URLs only

# ── Option 3: Backblaze B2 (10 GB free, NO card required) ──────────────────
# Sign up at https://www.backblaze.com/sign-up/cloud-storage
# Create a bucket, then create an Application Key (read+write).
# Find your endpoint in the bucket details page (e.g. s3.us-west-004.backblazeb2.com).
# STORAGE_PROVIDER=backblaze
# B2_APPLICATION_KEY_ID=your-b2-keyId
# B2_APPLICATION_KEY=your-b2-applicationKey
# B2_BUCKET_NAME=attendai-files
# B2_REGION=us-west-004
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_PUBLIC_URL=https://f004.backblazeb2.com/file/attendai-files  # optional CDN URL

# ── Option 4: MinIO (self-hosted, completely free) ──────────────────────────
# Run locally:  docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
# Then open http://localhost:9001, create bucket "attendai-files".
# STORAGE_PROVIDER=minio
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=attendai-files
# MINIO_PUBLIC_URL=http://localhost:9000/attendai-files

# ── Option 5: Supabase Storage (1 GB free, NO card, already in this project) ─
# No new account needed – uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# Create a public bucket named "attendai-files" in your Supabase dashboard.
# STORAGE_PROVIDER=supabase
# SUPABASE_STORAGE_BUCKET=attendai-files

# ── Option 6: Local filesystem (development / self-hosted only) ─────────────
# Files are written to LOCAL_STORAGE_PATH on disk.
# Serve the folder as static files (e.g. via Nginx or the built-in static plugin).
# STORAGE_PROVIDER=local
# LOCAL_STORAGE_PATH=./uploads
# LOCAL_STORAGE_PUBLIC_URL=http://localhost:3001/uploads

# Clerk (for auth verification)
CLERK_SECRET_KEY=your-clerk-secret-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
